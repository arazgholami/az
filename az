    private function highlightSegments(string $line, string $syntax): array
    {
        if ($syntax === 'html')  return $this->htmlSegments($line);
        if ($syntax === 'css')   return $this->cssSegments($line);
        if ($syntax === 'php')   return $this->phpSegments($line);
        if ($syntax === 'blade') return $this->bladeSegments($line);
        return [];
    }

    private function phpSegments(string $line): array
    {
        $segments = [];
        // Comments first (highest priority, applied last so they win)
        $this->addRegexSegments($segments, '/\/\/.*$/u', $line, "\033[90m");
        $this->addRegexSegments($segments, '/\/\*.*?\*\//u', $line, "\033[90m");
        $this->addRegexSegments($segments, '/#\[/u', $line, "\033[33m"); // attribute start
        // Strings (double and single quoted, with escape handling)
        $this->addRegexSegments($segments, '/("(?:[^"\\\\]|\\\\.)*"|\'(?:[^\'\\\\]|\\\\.)*\')/u', $line, "\033[32m");
        // PHP open/close tags
        $this->addRegexSegments($segments, '/<\?php\b|<\?=|\?>/u', $line, "\033[33m");
        // Keywords
        $kw = 'abstract|array|as|break|callable|case|catch|class|clone|const|continue|'
            . 'declare|default|do|echo|else|elseif|empty|enum|extends|final|finally|fn|for|'
            . 'foreach|function|global|goto|if|implements|include|include_once|instanceof|'
            . 'interface|isset|list|match|namespace|new|null|print|private|protected|public|'
            . 'readonly|require|require_once|return|static|switch|throw|trait|try|unset|use|'
            . 'while|yield|true|false|void|self|parent|int|string|float|bool|mixed|never|object';
        $this->addRegexSegments($segments, '/\\b(' . $kw . ')\\b/u', $line, "\033[35m");
        // Class names (PascalCase)
        $this->addRegexSegments($segments, '/\\b[A-Z][A-Za-z0-9_]*/u', $line, "\033[36m");
        // Variables
        $this->addRegexSegments($segments, '/\\$[a-zA-Z_][a-zA-Z0-9_]*/u', $line, "\033[33m");
        // Numbers
        $this->addRegexSegments($segments, '/\\b\\d+(?:\\.\\d+)?(?:e[+-]?\\d+)?\\b/u', $line, "\033[35m");
        // Function calls
        $this->addRegexSegments($segments, '/\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()/u', $line, "\033[34m");
        return $segments;
    }

    private function bladeSegments(string $line): array
    {
        $segments = $this->phpSegments($line);
        // Blade directives: @if, @foreach, @yield, @section etc.
        $this->addRegexSegments($segments, '/@[a-zA-Z][a-zA-Z0-9]*/u', $line, "\033[35m");
        // Blade echo: {{ ... }} and {!! ... !!}
        $this->addRegexSegments($segments, '/\{\{--.*?--\}\}/u', $line, "\033[90m");
        $this->addRegexSegments($segments, '/\{!!.*?!!\}/u', $line, "\033[33m");
        $this->addRegexSegments($segments, '/\{\{.*?\}\}/u', $line, "\033[33m");
        return $segments;
    }

    private function htmlSegments(string $line): array
    {
        $segments = [];
        $this->addRegexSegments($segments, '/<!--.*?-->/u', $line, "\033[90m");
        $this->addRegexSegments($segments, '/<\/?[A-Za-z][^>]*>/u', $line, "\033[36m");
        $this->addRegexSegments($segments, '/("[^"]*"|\'[^\']*\')/u', $line, "\033[32m");
        $this->addRegexSegments($segments, '/&[A-Za-z0-9#]+;/u', $line, "\033[35m");
        return $segments;
    }

    private function cssSegments(string $line): array
    {
        $segments = [];
        $this->addRegexSegments($segments, '/\/\*.*?\*\//u', $line, "\033[90m");
        $this->addRegexSegments($segments, '/("[^"]*"|\'[^\']*\')/u', $line, "\033[32m");
        $this->addRegexSegments($segments, '/@[A-Za-z_-]+/u', $line, "\033[35m");
        $this->addRegexSegments($segments, '/[A-Za-z_-][A-Za-z0-9_-]*(?=\s*:)/u', $line, "\033[33m");
        $this->addRegexSegments($segments, '/#[A-Fa-f0-9]{3,8}\b/u', $line, "\033[35m");
        $this->addRegexSegments($segments, '/\b\d+(?:\.\d+)?(?:px|em|rem|vh|vw|%|s|ms)?\b/u', $line, "\033[35m");
        if (strpos($line, '{') !== false) {
            $pos = strpos($line, '{');
            if ($pos !== false && $pos > 0) {
                $segments[] = [0, $pos, "\033[36m"];
            }
        }
        return $segments;
    }

    private function addRegexSegments(array &$segments, string $regex, string $line, string $color): void
    {
        if (preg_match_all($regex, $line, $matches, PREG_OFFSET_CAPTURE)) {
            foreach ($matches[0] as $match) {
                $text = $match[0];
                $start = $match[1];
                $segments[] = [$start, $start + strlen($text), $color];
            }
        }
    }

    private function colorAt(array $segments, int $pos): string
    {
        $color = '';
        foreach ($segments as $seg) {
            if ($pos >= $seg[0] && $pos < $seg[1]) {
                $color = $seg[2];
            }
        }
        return $color;
    }

    private function syntaxForPath(?string $path): string
    {
        if ($path === null) {
            return 'plain';
        }
        $ext = strtolower(pathinfo($path, PATHINFO_EXTENSION));
        if (in_array($ext, ['html', 'htm'], true)) {
            return 'html';
        }
        if ($ext === 'css') {
            return 'css';
        }
        // Blade: foo.blade.php or foo.blade
        $base = strtolower(basename($path));
        if (str_ends_with($base, '.blade.php') || $ext === 'blade') {
            return 'blade';
        }
        if (in_array($ext, ['php', 'phtml', 'php3', 'php4', 'php5', 'php7', 'php8', 'phps'], true)) {
            return 'php';
        }
        return 'plain';
    }

    private function wordCount(array $lines): int
    {
        $text = implode("\n", $lines);
        if ($text === '') {
            return 0;
        }
        if (preg_match_all('/[\p{L}\p{N}_]+/u', $text, $m)) {
            return count($m[0]);
        }
        return 0;
    }

    private function tab(): AzTab
    {
        return $this->tabs[$this->tabIndex];
    }

    private function absolutePath(string $path, ?string $base = null): string
    {
        if ($path === '') {
            return $base ?? getcwd();
        }
        if ($path[0] !== DIRECTORY_SEPARATOR && !preg_match('/^[A-Za-z]:[\\\/]/', $path)) {
            $path = ($base ?? getcwd()) . DIRECTORY_SEPARATOR . $path;
        }
        $real = realpath($path);
        if ($real !== false) {
            return $real;
        }
        $dir = dirname($path);
        $realDir = realpath($dir);
        return ($realDir ?: $dir) . DIRECTORY_SEPARATOR . basename($path);
    }

    private function relativePath(string $path): string
    {
        if (strpos($path, $this->root . DIRECTORY_SEPARATOR) === 0) {
            return substr($path, strlen($this->root) + 1);
        }
        return $path;
    }

    private function escapeControl(string $text): string
    {
        return preg_replace_callback('/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/', function ($m) {
            return '?';
        }, $text) ?? $text;
    }

    private function fitPlain(string $text, int $width): string
    {
        $text = $this->truncatePlain($text, $width);
        return $text . str_repeat(' ', max(0, $width - $this->visualWidth($text)));
    }

    private function fitAnsi(string $text, int $width): string
    {
        $plain = preg_replace('/\033\[[0-9;]*m/', '', $text) ?? $text;
        $len = $this->visualWidth($plain);
        if ($len >= $width) {
            return $this->truncateAnsi($text, $width);
        }
        return $text . str_repeat(' ', $width - $len);
    }

    private function truncatePlain(string $text, int $width): string
    {
        $out = '';
        $visible = 0;
        $len = strlen($text);
        for ($i = 0; $i < $len;) {
            $char = $this->utf8CharAt($text, $i);
            $charLen = max(1, strlen($char));
            $charWidth = $char === "\t" ? (4 - ($visible % 4)) : $this->charDisplayWidth($char);
            if ($charWidth > 0 && $visible + $charWidth > $width) {
                break;
            }
            $out .= $char === "\t" ? str_repeat(' ', max(1, $charWidth)) : $char;
            $visible += $charWidth;
            $i += $charLen;
        }
        return $out;
    }

    private function truncateAnsi(string $text, int $width): string
    {
        $out = '';
        $visible = 0;
        $len = strlen($text);
        for ($i = 0; $i < $len && $visible < $width;) {
            if ($text[$i] === "\033" && preg_match('/^\033\[[0-9;]*m/', substr($text, $i), $m)) {
                $out .= $m[0];
                $i += strlen($m[0]);
                continue;
            }

            $char = $this->utf8CharAt($text, $i);
            $charLen = max(1, strlen($char));
            $charWidth = $char === "\t" ? (4 - ($visible % 4)) : $this->charDisplayWidth($char);
            if ($charWidth > 0 && $visible + $charWidth > $width) {
                break;
            }
            $out .= $char === "\t" ? str_repeat(' ', max(1, $charWidth)) : $char;
            $visible += $charWidth;
            $i += $charLen;
        }
        if ($visible < $width) {
            $out .= str_repeat(' ', $width - $visible);
        }
        return $out . "\033[0m";
    }

    private function visualWidth(string $text, int $tabSize = 4): int
    {
        $col = 0;
        $len = strlen($text);
        for ($i = 0; $i < $len;) {
            $char = $this->utf8CharAt($text, $i);
            $charLen = max(1, strlen($char));
            if ($char === "\t") {
                $col += $tabSize - ($col % $tabSize);
            } else {
                $col += $this->charDisplayWidth($char);
            }
            $i += $charLen;
        }
        return $col;
    }

    private function utf8SequenceLength(int $ord): int
    {
        if ($ord >= 0xC2 && $ord <= 0xDF) {
            return 2;
        }
        if ($ord >= 0xE0 && $ord <= 0xEF) {
            return 3;
        }
        if ($ord >= 0xF0 && $ord <= 0xF4) {
            return 4;
        }
        return 1;
    }

    private function utf8CharAt(string $text, int $offset): string
    {
        $len = strlen($text);
        if ($offset < 0 || $offset >= $len) {
            return '';
        }

        $needed = $this->utf8SequenceLength(ord($text[$offset]));
        $char = substr($text, $offset, $needed);
        if ($needed > 1 && strlen($char) === $needed && $this->isValidUtf8($char)) {
            return $char;
        }
        return $text[$offset];
    }

    private function nextCharOffset(string $text, int $offset): int
    {
        $len = strlen($text);
        $offset = max(0, min($offset, $len));
        if ($offset >= $len) {
            return $len;
        }
        return min($len, $offset + max(1, strlen($this->utf8CharAt($text, $offset))));
    }

    private function prevCharOffset(string $text, int $offset): int
    {
        $offset = max(0, min($offset, strlen($text)));
        if ($offset === 0) {
            return 0;
        }
        $i = $offset - 1;
        while ($i > 0 && $this->isUtf8ContinuationByte(ord($text[$i]))) {
            $i--;
        }
        return $i;
    }

    private function clampByteCol(string $line, int $col): int
    {
        $len = strlen($line);
        $col = max(0, min($col, $len));
        while ($col > 0 && $col < $len && $this->isUtf8ContinuationByte(ord($line[$col]))) {
            $col--;
        }
        return $col;
    }

    private function removeLastUtf8Char(string $text): string
    {
        return substr($text, 0, $this->prevCharOffset($text, strlen($text)));
    }

    private function isUtf8ContinuationByte(int $ord): bool
    {
        return $ord >= 0x80 && $ord <= 0xBF;
    }

    private function isValidUtf8(string $text): bool
    {
        return preg_match('//u', $text) === 1;
    }

    private function containsControlChars(string $text): bool
    {
        return preg_match('/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/', $text) === 1;
    }

    private function charDisplayWidth(string $char): int
    {
        if ($char === '') {
            return 0;
        }
        if (!$this->isValidUtf8($char)) {
            return 1;
        }
        if (preg_match('/^\p{Mn}$/u', $char) === 1) {
            return 0;
        }

        $cp = $this->utf8Codepoint($char);
        if ($cp === null) {
            return 1;
        }
        if ($cp === 0 || ($cp < 32) || ($cp >= 0x7F && $cp < 0xA0)) {
            return 0;
        }

        return $this->isWideCodepoint($cp) ? 2 : 1;
    }

    private function utf8Codepoint(string $char): ?int
    {
        if ($char === '') {
            return null;
        }
        $b1 = ord($char[0]);
        $len = strlen($char);
        if ($b1 < 0x80) {
            return $b1;
        }
        if ($len >= 2 && $b1 >= 0xC2 && $b1 <= 0xDF) {
            return (($b1 & 0x1F) << 6) | (ord($char[1]) & 0x3F);
        }
        if ($len >= 3 && $b1 >= 0xE0 && $b1 <= 0xEF) {
            return (($b1 & 0x0F) << 12) | ((ord($char[1]) & 0x3F) << 6) | (ord($char[2]) & 0x3F);
        }
        if ($len >= 4 && $b1 >= 0xF0 && $b1 <= 0xF4) {
            return (($b1 & 0x07) << 18) | ((ord($char[1]) & 0x3F) << 12) | ((ord($char[2]) & 0x3F) << 6) | (ord($char[3]) & 0x3F);
        }
        return null;
    }

    private function isWideCodepoint(int $cp): bool
    {
        return ($cp >= 0x1100 && $cp <= 0x115F)
            || ($cp >= 0x2329 && $cp <= 0x232A)
            || ($cp >= 0x2E80 && $cp <= 0xA4CF)
            || ($cp >= 0xAC00 && $cp <= 0xD7A3)
            || ($cp >= 0xF900 && $cp <= 0xFAFF)
            || ($cp >= 0xFE10 && $cp <= 0xFE19)
            || ($cp >= 0xFE30 && $cp <= 0xFE6F)
            || ($cp >= 0xFF00 && $cp <= 0xFF60)
            || ($cp >= 0xFFE0 && $cp <= 0xFFE6)
            || ($cp >= 0x1F300 && $cp <= 0x1FAFF);
    }
